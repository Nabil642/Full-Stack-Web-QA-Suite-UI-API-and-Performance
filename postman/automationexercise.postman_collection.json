    "name": "AutomationExercise API Tests",
    "description": "Covers the public API of automationexercise.com. Note: responses always use HTTP 200, the real status is the responseCode field in the JSON body.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
