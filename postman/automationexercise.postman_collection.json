  "item": [
    {
      "name": "Products and brands",
      "item": [
        {
          "name": "GET all products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "// NOTE: this API answers HTTP 200 even for errors - the real result is inside the body",
                  "pm.test('HTTP status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body responseCode is 200', () => pm.expect(json.responseCode).to.eql(200));",
                  "pm.test('Products list is not empty', () => pm.expect(json.products).to.be.an('array').that.is.not.empty);",
                  "pm.test('Each product has the expected fields', () => {",
                  "  json.products.forEach(p => {",
                  "    pm.expect(p).to.have.all.keys('id', 'name', 'price', 'brand', 'category');",
                  "    pm.expect(p.price).to.match(/^Rs\\. \\d+/);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productsList"
          }
        },
        {
          "name": "POST to productsList (not allowed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Body responseCode is 405', () => pm.expect(json.responseCode).to.eql(405));",
                  "pm.test('Message explains the method is unsupported', () => pm.expect(json.message).to.include('not supported'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/productsList"
          }
        },
        {
          "name": "GET all brands",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Body responseCode is 200', () => pm.expect(json.responseCode).to.eql(200));",
                  "pm.test('Brands have id and brand name', () => {",
                  "  pm.expect(json.brands).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(json.brands[0]).to.have.all.keys('id', 'brand');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/brandsList"
          }
        },
        {
