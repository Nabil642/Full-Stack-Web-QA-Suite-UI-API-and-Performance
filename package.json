{
  "name": "automationexercise-qa-suite",
  "version": "1.0.0",
  "description": "UI, API and load tests for automationexercise.com using Playwright, Postman/Newman and JMeter",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "report": "playwright show-report",
    "postman": "newman run postman/automationexercise.postman_collection.json -e postman/automationexercise.postman_environment.json -r cli,htmlextra --reporter-htmlextra-export reports/postman/report.html",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "typescript": "^5.5.0"
  }
}
