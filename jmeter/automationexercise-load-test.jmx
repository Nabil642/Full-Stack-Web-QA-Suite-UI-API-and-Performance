<elementProp name="email" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp>
<stringProp name="Argument.value">nobody.${__threadNum}@example.com</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp><stringProp name="Argument.name">email</stringProp></elementProp>
<elementProp name="password" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp>
<stringProp name="Argument.value">nope</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp><stringProp name="Argument.name">password</stringProp></elementProp>
</collectionProp>
